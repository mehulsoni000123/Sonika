# ---- Sonika configuration (copy to .env or set in your host's environment) ----

# Required: Claude does the editing.
ANTHROPIC_API_KEY=sk-ant-...
# Model used for planning/revising cuts (default claude-opus-5-5).
ANTHROPIC_MODEL=claude-opus-5-5

# Shared password for the editor UI. Leave empty to run open (local only!).
APP_PASSWORD=change-me

# Google Drive (OAuth 2.0 "Web application" client from console.cloud.google.com).
# Add GOOGLE_REDIRECT_URI to the client's authorized redirect URIs, and enable the Drive API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-host.example.com/auth/google/callback

# Where projects, proxies and renders live (mount a persistent volume here in the cloud).
DATA_DIR=./data

# Server
PORT=8080
# Parallel ffmpeg segment renders (defaults to CPU count).
RENDER_CONCURRENCY=
# Final-render encoder: libx264 (default) or h264_nvenc on GPU machines.
FFMPEG_VIDEO_ENCODER=libx264
# Preview proxy height (default 540).
PROXY_HEIGHT=540
# Proxy codec: h264 (default, plays everywhere) or vp9 (for Chromium builds without H.264).
PROXY_CODEC=h264
# Font used for on-screen text.
FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Run without an Anthropic key: deterministic mock cuts (tests / demos).
MOCK_AI=0
